# =============================================================================
# SIMS — Contoh konfigurasi environment
# =============================================================================
# Salin file ini menjadi .env.local, lalu isi dengan nilai milik Anda sendiri:
#
#   cp .env.example .env.local
#
# .env.local sudah masuk .gitignore dan TIDAK BOLEH di-commit.
# Jangan pernah menaruh nilai asli (API key) di file .env.example ini.
# -----------------------------------------------------------------------------


# --- Appwrite: koneksi publik (terekspos ke browser) -------------------------
# Region endpoint Appwrite Anda, contoh:
#   https://cloud.appwrite.io/v1          (default)
#   https://sgp.cloud.appwrite.io/v1      (Singapore)
#   https://fra.cloud.appwrite.io/v1      (Frankfurt)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID dari Appwrite Console → Overview
NEXT_PUBLIC_APPWRITE_PROJECT_ID=isi_project_id_anda


# --- Appwrite: kredensial server (RAHASIA, jangan diberi prefix NEXT_PUBLIC) --
# Appwrite Console → Overview → Integrations → API Keys → Create API Key.
# Scope minimal yang dibutuhkan: databases.read, databases.write,
# collections.read, documents.read, documents.write, files.read, files.write,
# users.read, users.write, sessions.write
APPWRITE_API_KEY=isi_api_key_rahasia_anda


# --- Appwrite: ID database, collection, dan bucket ----------------------------
# Dibuat otomatis oleh `npm run appwrite:setup`.
APPWRITE_DATABASE_ID=helios-db
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_ITEMS_COLLECTION_ID=items
APPWRITE_LOANS_COLLECTION_ID=loans
APPWRITE_ITEM_IMAGES_BUCKET_ID=item-images


# --- Sesi ---------------------------------------------------------------------
# Nama cookie sesi. Bebas diganti, cukup konsisten satu proyek.
SESSION_COOKIE_NAME=sims-session


# --- Brevo: pengiriman email OTP (RAHASIA) ------------------------------------
# https://app.brevo.com → SMTP & API → API Keys.
# Boleh dikosongkan saat pengembangan lokal; fitur OTP via email akan nonaktif.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@domain-anda.com
BREVO_SENDER_NAME=SIMS Scitech
